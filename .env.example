# Desarrollo local: DATABASE_URL y DIRECT_URL apuntan a la misma base local.
# Supabase: DATABASE_URL usa el pooler de transacciones (6543); DIRECT_URL
# usa el pooler de sesiones (5432) para las migraciones de Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
